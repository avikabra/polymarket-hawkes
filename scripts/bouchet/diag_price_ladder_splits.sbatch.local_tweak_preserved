#!/bin/bash
#SBATCH --job-name=diag-split
#SBATCH --partition=day
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=00:10:00
#SBATCH --account=pi_btk22
#SBATCH --output=logs/bouchet_diag_split_%j.out
#SBATCH --error=logs/bouchet_diag_split_%j.err

set -euo pipefail

PROJECT_ROOT=/nfs/roberts/project/pi_btk22/ak2876

module load miniconda
export PATH="$PROJECT_ROOT/.local/bin:$PATH"
export UV_CACHE_DIR="$PROJECT_ROOT/.cache/uv"

cd "$PROJECT_ROOT/thesis-polymarket"
mkdir -p logs

uv run python -c "
import pandas as pd
df = pd.read_parquet('data/analysis/shock_embeddings.parquet')
sub = df[df['valid_24h'] == True]
sub = sub[sub['category'] == 'price_ladder']
print('total price_ladder valid_24h rows:', len(sub))
print(sub['split'].value_counts(dropna=False))
print()
print('full corpus split counts (all categories, valid_24h):')
print(df[df['valid_24h']==True]['split'].value_counts(dropna=False))
print()
print('overall split counts (all rows, incl not valid_24h):')
print(df['split'].value_counts(dropna=False))
"
